# {{ ansible_managed }}
scope: {{ cluster_scope }}
namespace: {{ cluster_namespace }}
name: {{ inventory_hostname }}

log:
  level: INFO

restapi:
  listen: {{ node_ip }}:{{ patroni_restapi_port }}
  connect_address: {{ node_ip }}:{{ patroni_restapi_port }}
  authentication:
    username: {{ patroni_restapi_username }}
    password: {{ patroni_restapi_password | to_json }}

etcd3:
  hosts:
{% for h in groups['pg_cluster'] %}
    - {{ hostvars[h]['node_ip'] }}:{{ etcd_client_port }}
{% endfor %}

bootstrap:
  dcs:
    {{ patroni_dcs | to_nice_yaml(indent=2) | indent(4) | trim }}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        {{ pg_dcs_parameters | to_nice_yaml(indent=2) | indent(8) | trim }}
  initdb:
    - encoding: UTF8
    - locale: C.UTF-8
    - data-checksums

postgresql:
  listen: 127.0.0.1,{{ node_ip }}:{{ pg_port }}
  connect_address: {{ node_ip }}:{{ pg_port }}
  data_dir: {{ pg_data_dir }}
  bin_dir: {{ pg_bin_dir }}
  pgpass: /var/lib/pgsql/.pgpass_patroni
  authentication:
    superuser:
      username: {{ pg_superuser }}
      password: {{ pg_superuser_password | to_json }}
    replication:
      username: {{ pg_replication_user }}
      password: {{ pg_replication_password | to_json }}
    rewind:
      username: {{ pg_rewind_user }}
      password: {{ pg_rewind_password | to_json }}
  parameters:
    {{ pg_local_parameters | to_nice_yaml(indent=2) | indent(4) | trim }}
  pg_hba:
    - local   all          all                                peer
    - local   replication  all                                peer
    - host    all          all          127.0.0.1/32          scram-sha-256
    - host    replication  {{ pg_replication_user }}  {{ cluster_network_cidr }}  scram-sha-256
    - host    all          all          {{ cluster_network_cidr }}  scram-sha-256
{% for cidr in app_allowed_cidrs | difference([cluster_network_cidr]) %}
    - host    all          all          {{ cidr }}  scram-sha-256
{% endfor %}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
